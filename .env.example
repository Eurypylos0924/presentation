# AI 정리 기능 설정 (선택). 이 파일을 .env 로 복사해서 채우세요.
# 비워두면 AI 없이 '문장 나누기' 규칙으로 칸을 채웁니다.

# openai  : OpenAI 및 호환 서버(Ollama, vLLM, LM Studio 등)
# anthropic : Anthropic API
# none    : AI 사용 안 함
AI_PROVIDER=none

# 사용할 모델 이름 (팀에서 정한 모델)
AI_MODEL=

# API 키 (로컬 모델이면 비워도 됨)
AI_API_KEY=

# 호환 서버 주소. 예) Ollama: http://localhost:11434/v1
AI_BASE_URL=
